output "ansible_inventory" {
  value = <<-EOT
    # Generated by `make infra-up POOL=cc`. Do not edit.
    [cc]
    ${module.confidential.name} ansible_host=${module.confidential.public_ip} private_ip=${module.confidential.private_ip} al_instance_type=${var.cc_vm_size}

    [twin]
    %{for t in module.twin~}
    ${t.name} ansible_host=${t.public_ip} private_ip=${t.private_ip} al_instance_type=${var.twin_vm_size}
    %{endfor~}

    [all:vars]
    ansible_user=${var.ssh_user}
    al_cloud=azure
    al_region=${var.location}
    maa_url=${var.maa_url}
    ansible_ssh_private_key_file=${trimsuffix(pathexpand(var.ssh_public_key_path), ".pub")}
  EOT
}
