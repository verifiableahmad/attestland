# Every pinned version in one place. Sourced by make, Ansible and the
# benchmark harnesses, and copied into every result file.
#
# Pinned on 2026-11-07. Re-check each value against upstream before a phase
# starts spending money (spec: "Ground rules").
#
# Format: KEY=value, comments on their own lines only. make, bash and Python
# read this file; a "#" inside a line or a space after the value would reach
# them differently (bench/tests/test_versions.py checks all three agree).
# *_SHA256: checksums of the downloads the roles verify (taken 2026-11-17).

# --- Base image -------------------------------------------------------------
BASE_OS=ubuntu-22.04
BASE_KERNEL_FLAVOR=generic
# Canonical's AMI name (the same in every region). Pinned so a new jammy build
# does not replace every VM on the next apply (D-3); it fixes the kernel that
# DKMS builds the driver against. Bump deliberately.
AWS_AMI_NAME=ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-20261109

# --- NVIDIA stack -----------------------------------------------------------
NVIDIA_DRIVER_VERSION=580.196.07
# apt revision of that version in NVIDIA's repo (older ones: 0ubuntu1)
NVIDIA_DRIVER_PKG_REV=1ubuntu1
NVIDIA_DRIVER_BRANCH=580
# open kernel modules; required for CC on H100
NVIDIA_DRIVER_FLAVOR=open
CUDA_VERSION=12.9.1
NCCL_VERSION=2.27.7-1+cuda12.9
NCCL_TESTS_REF=v2.17.1
DCGM_VERSION=4.4.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.4.1-4.6.0-ubuntu22.04
NVIDIA_CONTAINER_TOOLKIT_VERSION=1.18.0
# NVIDIA Attestation SDK (nvattest CLI)
NVAT_VERSION=1.1.0

# --- Containers -------------------------------------------------------------
# An OCI reference; the sbatch scripts turn it into enroot's registry#image form.
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3
PYTORCH_VERSION=2.9.0
VLLM_IMAGE=docker.io/vllm/vllm-openai:v0.11.0
VLLM_VERSION=0.11.0
ENROOT_VERSION=3.5.0
ENROOT_SHA256=28c3e25d0e29f2a044b121cfa729fdc51601c16707937f72fce3b2e2502f6d36
ENROOT_CAPS_SHA256=6a70b1cada238fe329ee83f50c6df775513d4977f1bc5aea248bb8d327bdc874
PYXIS_VERSION=0.21.0

# --- Schedulers -------------------------------------------------------------
SLURM_VERSION=25.05.3
SLURM_SHA256=c7c8678f5fede6cdcaa2ad3ff39d7321f1ece9a0b36c433eaef104f55dfa8936
KUBERNETES_VERSION=1.34.1
# containerd is Ubuntu's package, not pinned here: result files record the
# installed version (bench/lib/result.py), not a pin nothing enforces.
GPU_OPERATOR_VERSION=v25.10.0
KUEUE_VERSION=v0.14.1
KUEUE_MANIFEST_SHA256=a28f57a3e9b53f444ccfca7d0b2a23518bc4ca751aed23ebd4780aedd0c6845a
CALICO_VERSION=v3.30.3
CALICO_MANIFEST_SHA256=9382d2b27a76f40c170454b408653e6d71e2205ef0aef069e942bb690e7381d0

# --- Storage and observability ---------------------------------------------
AWSCLI_IMAGE=docker.io/amazon/aws-cli:2.27.50
# the CLI v2 zip of the same version, installed on the control VM
AWSCLI_SHA256=2ed5b5a1d92f3aa860034b0d9ec0902574852c3e60916e221414abb6f1504d9e
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.6.0
ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:v0.28.1
GRAFANA_IMAGE=docker.io/grafana/grafana:12.2.0
LOKI_IMAGE=docker.io/grafana/loki:3.5.5
ALLOY_IMAGE=docker.io/grafana/alloy:v1.11.0
NODE_EXPORTER_VERSION=1.9.1
NODE_EXPORTER_SHA256=becb950ee80daa8ae7331d77966d94a611af79ad0d3307380907e0ec08f5b4e8
# rivosinc/prometheus-slurm-exporter: release binary, no image is published
SLURM_EXPORTER_VERSION=1.6.4
SLURM_EXPORTER_SHA256=193d75ebafcce7b5ec95d9c01e73a689e580d741c6182606f7764e9d48361260

# --- Network lab ------------------------------------------------------------
# first release the sonic-vs lab was checked on (ADR 012)
CONTAINERLAB_VERSION=0.77.0
CONTAINERLAB_SHA256=675eea8bd4d05ea3abc4a98cfa859975c9886705d6a510fead4dfd8dbed8b793
# docker-sonic-vs is a build artifact, not on a registry, and amd64 only. The
# build server serves the latest build of a branch; sonic-image.sh loads it under
# SONIC_VS_IMAGE and checks it against SONIC_VS_SHA256 once that is pinned.
SONIC_VS_BRANCH=202511
SONIC_VS_IMAGE=docker-sonic-vs:202511
SONIC_VS_SHA256=
FRR_IMAGE=quay.io/frrouting/frr:10.4.1
LAB_HOST_IMAGE=docker.io/nicolaka/netshoot:v0.14

# --- Provisioning lab -------------------------------------------------------
TINKERBELL_STACK_VERSION=v0.19.2
SUSHY_TOOLS_VERSION=2.1.0
# lab host (infra/lab-host); pinned 2026-11-12
K3D_VERSION=v5.8.3
HELM_VERSION=v3.19.0
# helm-<version>-linux-amd64.tar.gz (get.helm.sh)
HELM_SHA256=a7f81ce08007091b86d8bd696eb4d86b8d0f2e1b9f6c714be62f82f96a594496

# --- Infra tooling ----------------------------------------------------------
# the version that wrote the current state files
OPENTOFU_VERSION=1.13.9
ANSIBLE_CORE_VERSION=2.19.2
COSIGN_VERSION=v2.6.0
GO_VERSION=1.24.0
