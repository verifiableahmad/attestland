# Generated by `make infra-up POOL=gpu`. Do not edit.
[control]
${control.name} ansible_host=${control.public} private_ip=${control.private}

[gpu]
%{ for g in gpus ~}
${g.name} ansible_host=${g.public} private_ip=${g.private}
%{ endfor ~}

[all:vars]
ansible_user=${ssh_user}
al_cloud=gcp
al_region=${region}
al_gpu_instance_type=${gpu_type}
control_private_ip=${control.private}
s3_endpoint=${s3.endpoint}
s3_access_key=${s3.access_key}
s3_secret_key=${s3.secret_key}
bucket_prefix=${s3.prefix}
