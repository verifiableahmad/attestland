# Every pinned version in one place. Sourced by make, Ansible and the
# benchmark harnesses, and copied into every result file.
#
# Pinned on 2026-11-07. Re-check each value against upstream before a phase
# starts spending money (spec: "Ground rules").

# --- Base image -------------------------------------------------------------
BASE_OS=ubuntu-22.04
BASE_KERNEL_FLAVOR=generic

# --- NVIDIA stack -----------------------------------------------------------
NVIDIA_DRIVER_VERSION=580.82.07
NVIDIA_DRIVER_BRANCH=580
NVIDIA_DRIVER_FLAVOR=open           # open kernel modules; required for CC on H100
CUDA_VERSION=12.9.1
NCCL_VERSION=2.27.7-1+cuda12.9
NCCL_TESTS_REF=v2.17.1
DCGM_VERSION=4.4.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.4.1-4.6.0-ubuntu22.04
NVIDIA_CONTAINER_TOOLKIT_VERSION=1.18.0
NVAT_VERSION=1.1.0                  # NVIDIA Attestation SDK (nvattest CLI)

# --- Containers -------------------------------------------------------------
PYTORCH_IMAGE=nvcr.io#nvidia/pytorch:25.10-py3
PYTORCH_VERSION=2.9.0
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
VLLM_VERSION=0.11.0
ENROOT_VERSION=3.5.0
PYXIS_VERSION=0.21.0

# --- Schedulers -------------------------------------------------------------
SLURM_VERSION=25.05.3
KUBERNETES_VERSION=1.34.1
CONTAINERD_VERSION=2.1.4
GPU_OPERATOR_VERSION=v25.10.0
KUEUE_VERSION=v0.14.1
CALICO_VERSION=v3.30.3

# --- Storage and observability ---------------------------------------------
AWSCLI_IMAGE=amazon/aws-cli:2.27.50
PROMETHEUS_IMAGE=prom/prometheus:v3.6.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:12.2.0
LOKI_IMAGE=grafana/loki:3.5.5
ALLOY_IMAGE=grafana/alloy:v1.11.0
NODE_EXPORTER_VERSION=1.9.1
SLURM_EXPORTER_IMAGE=ghcr.io/rivosinc/prometheus-slurm-exporter:v1.6.4

# --- Network lab ------------------------------------------------------------
CONTAINERLAB_VERSION=0.70.2
SRLINUX_IMAGE=ghcr.io/nokia/srlinux:25.7.2
FRR_IMAGE=quay.io/frrouting/frr:10.4.1
LAB_HOST_IMAGE=nicolaka/netshoot:v0.14

# --- Provisioning lab -------------------------------------------------------
TINKERBELL_STACK_VERSION=v0.19.2
SUSHY_TOOLS_VERSION=2.1.0
K3D_VERSION=v5.8.3                  # lab host (infra/lab-host); pinned 2026-11-12
HELM_VERSION=v3.19.0

# --- Infra tooling ----------------------------------------------------------
OPENTOFU_VERSION=1.10.6
ANSIBLE_CORE_VERSION=2.19.2
COSIGN_VERSION=v2.6.0
GO_VERSION=1.24.0
