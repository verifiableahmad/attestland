# Generated by `make infra-up POOL=gpu`. Do not edit.
[control]
${control.name} ansible_host=${control.public} private_ip=${control.private} instance_id=${control.id}

[gpu]
%{ for g in gpus ~}
${g.name} ansible_host=${g.public} private_ip=${g.private} instance_id=${g.id}
%{ endfor ~}

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key}
al_cloud=aws
al_region=${region}
al_gpu_instance_type=${gpu_type}
control_private_ip=${control.private}
bucket_prefix=${prefix}
