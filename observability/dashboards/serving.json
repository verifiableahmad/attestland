{
  "uid": "al-serving",
  "title": "Attestland / Serving",
  "tags": [
    "attestland"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(vllm:request_success_total[1m]))",
          "legendFormat": "ok",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "TTFT p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Inter-token latency p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running",
          "refId": "B"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "KV cache usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg(vllm:kv_cache_usage_perc)",
          "legendFormat": "kv",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Output tokens/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "tokens/s",
          "refId": "A"
        }
      ],
      "id": 6
    }
  ]
}
