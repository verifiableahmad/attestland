output "ansible_inventory" {
  value = <<-EOT
    # Generated by `make infra-up POOL=cc`. Do not edit.
    [cc]
    %{for n, i in google_compute_instance.h100~}
    %{if local.vms[n].confidential~}
    ${n} ansible_host=${i.network_interface[0].access_config[0].nat_ip} private_ip=${i.network_interface[0].network_ip} al_instance_type=${var.machine_type}
    %{endif~}
    %{endfor~}

    [twin]
    %{for n, i in google_compute_instance.h100~}
    %{if !local.vms[n].confidential~}
    ${n} ansible_host=${i.network_interface[0].access_config[0].nat_ip} private_ip=${i.network_interface[0].network_ip} al_instance_type=${var.machine_type}
    %{endif~}
    %{endfor~}

    [all:vars]
    ansible_user=${var.ssh_user}
    al_cloud=gcp
    al_region=${var.region}
  EOT
}
