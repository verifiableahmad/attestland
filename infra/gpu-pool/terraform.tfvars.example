region                = "us-east-1"
az                    = "us-east-1a" # another of var.azs if this zone has no g6 capacity
admin_cidrs           = ["REPLACE.your.ip.addr/32"]
spot                  = false        # true needs G spot quota (0 today); false for timed benchmarks
phase                 = 2
ssh_public_key_path   = "~/.ssh/id_ed25519.pub"
budget_contact_emails = ["REPLACE@example.com"]
